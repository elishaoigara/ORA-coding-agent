# Optional but strongly recommended for every internet-accessible deployment.
# When set, ORA requires a login and stores only a signed HttpOnly session cookie.
APP_PASSWORD=

# Configure at least one OpenAI-compatible model provider.
# GROQ_API_KEY=
# DEEPSEEK_API_KEY=
# QWEN_API_KEY=
# DASHSCOPE_API_KEY=        # alternate variable name for Qwen
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=

# Required for repository browsing, Agent mode, commits, and optional Gist sync.
# Classic PAT scopes: repo (private repositories) and gist (history sync).
GITHUB_PAT=

# Optional request budget for one agent batch, in milliseconds.
# Values are clamped to 10,000–280,000. Default: 45,000.
# AGENT_WATCHDOG_MS=45000

# Optional safety budgets for one agent run. Values are clamped server-side.
# AGENT_MAX_ITERATIONS=18
# AGENT_MAX_TOOL_CALLS=48
# AGENT_MAX_CHANGES=32
