# ── App password (optional) ─────────────────────────────────────────────────────
# APP_PASSWORD=your-secret-here

# ── AI Provider API Keys ──────────────────────────────────────────────────────
# At least one provider must be configured. Key requirements:
#   GROQ:       https://console.groq.com/keys
#   DEEPSEEK:   https://platform.deepseek.com/api_keys
#   QWEN:       https://bailian.console.aliyun.com/ (DASHSCOPE_API_KEY)
#   OPENAI:     https://platform.openai.com/api-keys
#   OPENROUTER: https://openrouter.ai/keys

# GROQ_API_KEY=
# DEEPSEEK_API_KEY=
# QWEN_API_KEY=
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=

# Alibaba Cloud DashScope (alternative name for QWEN key)
# DASHSCOPE_API_KEY=

# ── Optional: Anthropic (experimental, uses custom API format) ─────────────────
# ANTHROPIC_API_KEY=

# ── Active provider ────────────────────────────────────────────────────────────
# Which provider to use by default. Options: groq, deepseek, qwen, openai, openrouter
# ACTIVE_PROVIDER=openrouter

# ── GitHub Integration (Required for Agent mode) ───────────────────────────────
# Personal Access Token with repo scope.
# Create at: https://github.com/settings/tokens
GITHUB_PAT=

# ── Agent watchdog (optional) ──────────────────────────────────────────────────
# Maximum time (ms) the agent can run before pausing for user confirmation.
# Default: 45000 (45 seconds)
# AGENT_WATCHDOG_MS=45000
