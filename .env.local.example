# ── Active provider (fallback if UI doesn't specify one) ──────────────────────
# Options: groq | deepseek | qwen | openai | anthropic
ACTIVE_PROVIDER=groq

# ── API Keys — add only the ones you use ─────────────────────────────────────

# Groq — fast LLaMA inference (free tier available)
# Get key: https://console.groq.com
GROQ_API_KEY=gsk_...

# DeepSeek — great coding model, very cheap
# Get key: https://platform.deepseek.com
DEEPSEEK_API_KEY=sk-...

# Qwen — Alibaba's model family (qwen3-coder-plus is strong for code)
# Get key: https://dashscope.console.aliyun.com
# Note: if you're in mainland China, change baseUrl in providers.ts to:
#   https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_API_KEY=sk-...

# OpenAI (optional)
OPENAI_API_KEY=sk-...

# Anthropic Claude (optional)
ANTHROPIC_API_KEY=sk-ant-...

# ── GitHub integration ────────────────────────────────────────────────────────
# Create at: https://github.com/settings/tokens/new
# Scopes needed: repo (read access)
GITHUB_PAT=ghp_...

# ── App password (protects the UI when deployed) ─────────────────────────────
# Leave as "change_me_in_production" to disable auth in local dev
APP_PASSWORD=change_me_in_production
